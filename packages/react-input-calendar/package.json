{
  "name": "@b.taranenko/react-input-calendar",
  "version": "0.0.0",
  "description": "Accessible, themeable React date pickers with zero runtime dependencies: single date, range, multiple dates, date + time and an inline calendar.",
  "keywords": [
    "react",
    "datepicker",
    "date-picker",
    "calendar",
    "date-range",
    "datetime",
    "accessible",
    "zero-dependency",
    "themeable"
  ],
  "author": "Bogdan Taranenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogdanTaranenko/react-input-calendar.git",
    "directory": "packages/react-input-calendar"
  },
  "homepage": "https://bogdantaranenko.github.io/react-input-calendar/",
  "bugs": "https://github.com/BogdanTaranenko/react-input-calendar/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size": "size-limit",
    "check:exports": "publint && attw --pack . --exclude-entrypoints ./styles.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsdown/css": "0.23.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.0",
    "tsdown": "0.23.0",
    "unrun": "^0.3.1",
    "vitest": "^5.0.1"
  }
}
